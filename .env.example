# Preview/default server stay mocked. Live vision uses private provider.env from npm run setup:provider; never save its key in this synced repo.
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8787
# Pause analysis without disabling draft review or ICS.
ANALYSIS_ENABLED=true
# Optional: limit the local service to one extension ID.
ALLOWED_EXTENSION_ID=

# Used only by the packaging script for Google Calendar sign-in.
GOOGLE_CLIENT_ID=
# Public extension key used to keep a development extension ID stable.
# This is the public key from Chrome, not a signing private key.
CHROME_EXTENSION_KEY=
